{
  "name": "jarvis-cosmic-web",
  "version": "2.0.50",
  "private": true,
  "type": "module",
  "description": "JARVIS AI - Cosmic Intelligence Web Application converted from Android with Express + Google Gemini SDK backend",
  "scripts": {
    "dev:server": "node server/index.js --dev",
    "dev:client": "vite",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server api tests",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:server": "node server/index.js --preview",
    "start:preview": "npm run build && node server/index.js --preview"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@types/three": "^0.187.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.6",
    "@types/express": "^5.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
