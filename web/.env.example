# Google Gemini API Key (Keep strictly on the server! Never expose in VITE_ vars)
GEMINI_API_KEY=

# Primary Gemini model (defaults to gemini-3.8-flash — Free Tier eligible)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Comma-separated ordered list of approved Free-Tier fallback models
# Paid-only (Pro/Ultra/Gemini-4) and deprecated (1.5/2.0/2.5-flash) models are automatically rejected.
GEMINI_FREE_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# Optional: Tavily Search API key to supplement Gemini Google Search grounding in Research Studio
TAVILY_API_KEY=

# Port for Express server (Cloud Run injects PORT=8080; Vercel routes via api/index.js)
PORT=8080

# Allowed CORS origin (* or comma-separated origins in production)
CORS_ORIGIN=*

# Optional: Shared secret Bearer token to protect /api/* endpoints when exposed publicly
APP_ACCESS_TOKEN=

# Optional: Public backend base URL when hosting frontend separately on GitHub Pages / Netlify / Firebase Hosting
# Leave blank for Vercel, Google Cloud Run (same origin), or local Vite dev proxy
VITE_API_BASE_URL=
