# Google Gemini API Key (Keep this strictly on the server! Never expose in VITE_ vars)
GEMINI_API_KEY=

# Gemini model to use (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Port for Express server (Cloud Run automatically injects PORT=8080)
PORT=8080

# Allowed CORS origin (* or comma-separated origins in production)
CORS_ORIGIN=*

# Optional: Public backend base URL when hosting frontend separately on Netlify / Firebase Hosting
# Leave blank for Google Cloud Run (same origin), Vercel, or local Vite dev proxy
VITE_API_BASE_URL=

