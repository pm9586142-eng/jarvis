# ============================================================
# JARVIS AI — FREE-ONLY MULTI-PROVIDER SERVER CONFIGURATION
# STRICT ₹0 / ZERO-COST POLICY — NO PAID MODELS OR BILLING
# ============================================================
# Configure ONE OR MORE free provider API keys below.
# NEVER put any API key in a VITE_* variable — keys stay strictly server-side.

# 1. Google Gemini Free Tier (Primary Provider)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
# Verified Free Tier default model (paid/deprecated models are automatically rejected)
GEMINI_MODEL=gemini-3.8-flash
# Optional comma-separated Free-Tier Gemini fallback chain (paid/deprecated IDs are rejected)
GEMINI_FREE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# 2. Groq Free API (Automatic Free Fallback #1 on HTTP 429)
# Get a free developer key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional comma-separated allowlisted Groq Free open-weight models
GROQ_FREE_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,qwen/qwen3.8-27b,llama-3.1-8b-instant

# 3. OpenRouter FREE Models ONLY (Automatic Free Fallback #2 — Live $0 Pricing Verified)
# Get a free key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Only strictly ":free" / "openrouter/free" models verified at $0.00 prompt & completion pricing are permitted
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,liquid/lfm-3-1.7b:free,openrouter/free
OPENROUTER_APP_REFERER=https://jarvis-ai.local

# Optional provider failover order (valid values: gemini,groq,openrouter)
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Optional: Tavily Search API Key for supplemental Phase 4 web research
TAVILY_API_KEY=

# Express server port (default 3001 for dev proxy, 8080 for production/Cloud Run)
PORT=3001

# Allowed CORS origin(s) for browser frontend (comma-separated or * for development)
CORS_ORIGIN=*

# Optional Bearer access token to lock down /api/* routes (leave empty to allow open access)
APP_ACCESS_TOKEN=

# Optional frontend override if hosting frontend and backend on separate domains
# Leave blank when serving both via Express or Vercel (same-origin /api)
VITE_API_BASE_URL=
