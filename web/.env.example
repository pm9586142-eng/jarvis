# ============================================================
# AM AI (JARVIS) — MULTI-AI BRAIN INFRASTRUCTURE CONFIGURATION
# STRICT $0 / ₹0 ZERO-COST ENFORCEMENT BY DEFAULT
# ============================================================
# Configure ONE OR MORE free-tier AI provider keys below.
# NEVER put any API key in a VITE_* variable — secrets stay strictly server-side.
# Providers without keys remain honestly marked UNCONFIGURED (never falsely CONNECTED).

# ------------------------------------------------------------
# 1. Google Gemini Free Tier (Primary Provider)
# Free API key: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FREE_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite

# ------------------------------------------------------------
# 2. Groq Free Tier (Ultra-fast open-weight inference)
# Free API key: https://console.groq.com/keys
# ------------------------------------------------------------
GROQ_API_KEY=
GROQ_FREE_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,openai/gpt-oss-20b,qwen/qwen3.8-27b,llama-3.1-8b-instant

# ------------------------------------------------------------
# 3. OpenRouter FREE Models ONLY ($0.00 live pricing verified)
# Free API key: https://openrouter.ai/keys
# Only ":free" / "openrouter/free" models verified at $0 prompt/completion are allowed.
# ------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,cohere/north-mini-code:free,liquid/lfm-3-1.7b:free,openrouter/free
OPENROUTER_APP_REFERER=https://am-ai.local

# ------------------------------------------------------------
# 4. Mistral AI (Experiment Free Tier — La Plateforme)
# https://console.mistral.ai/
# ------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_FREE_MODELS=mistral-small-latest,codestral-latest,pixtral-12b-2409

# ------------------------------------------------------------
# 5. Cohere (Free Trial API Key — non-commercial rate-limited)
# https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------
COHERE_API_KEY=
COHERE_FREE_MODELS=command-r7b-12-2024,command-r-08-2024

# ------------------------------------------------------------
# 6. Cloudflare Workers AI (Free Daily Neurons Quota)
# https://dash.cloudflare.com/ (Requires both Account ID & API Token)
# ------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_MODELS=@cf/meta/llama-3.3-70b-instruct-fp8-fast,@cf/deepseek-ai/deepseek-r1-distill-qwen-32b,@cf/qwen/qwen2.5-coder-32b-instruct

# ------------------------------------------------------------
# 7. NVIDIA NIM (Free Developer Build Credits)
# https://build.nvidia.com/
# ------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_FREE_MODELS=meta/llama-3.3-70b-instruct,deepseek-ai/deepseek-r1,qwen/qwen2.5-coder-32b-instruct

# ------------------------------------------------------------
# 8. SambaNova Cloud (Free Developer Tier)
# https://cloud.sambanova.ai/
# ------------------------------------------------------------
SAMBANOVA_API_KEY=
SAMBANOVA_FREE_MODELS=Meta-Llama-3.3-70B-Instruct,DeepSeek-R1-Distill-Llama-70B,Qwen2.5-Coder-32B-Instruct

# ------------------------------------------------------------
# 9. Hugging Face Inference Router (Free Tier Credits)
# https://huggingface.co/settings/tokens
# ------------------------------------------------------------
HUGGINGFACE_API_KEY=
HUGGINGFACE_FREE_MODELS=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-Coder-32B-Instruct,mistralai/Mistral-Small-24B-Instruct-2501

# ------------------------------------------------------------
# 10. Ollama Local / Self-Hosted ($0 Hardware Execution)
# Only works if reachable from the server host (local dev / self-hosted VPS)
# ------------------------------------------------------------
OLLAMA_BASE_URL=
OLLAMA_FREE_MODELS=llama3.2,qwen2.5-coder:7b,deepseek-r1:8b

# ------------------------------------------------------------
# 11. DeepSeek Direct API — PAID ONLY (NO FREE TIER)
# Registered transparently in the Multi-AI Brain Registry,
# STRICTLY BLOCKED from execution while STRICT_ZERO_COST=true ($0 guard).
# To run DeepSeek R1 at $0, use SambaNova, NVIDIA NIM, Cloudflare, OpenRouter :free, or Ollama.
# ------------------------------------------------------------
DEEPSEEK_API_KEY=

# ------------------------------------------------------------
# Multi-AI Brain Routing & Security Policies
# ------------------------------------------------------------
# Keep true to enforce strict $0 budget (blocks paid providers & paid models)
STRICT_ZERO_COST=true
# Optional failover priority order for core free providers
AI_PROVIDER_ORDER=gemini,groq,openrouter,mistral,sambanova,nvidia,cloudflare,cohere,huggingface,ollama
# Default Multi-AI Collaboration trigger: auto | on | off
BRAIN_COLLABORATION_MODE=auto

# Optional: Tavily Search API Key for supplemental web research
TAVILY_API_KEY=

# Optional: YouTube Data API v3 Key for JARVIS YouTube Search & Media Control
# Setup: Enable "YouTube Data API v3" in Google Cloud Console -> APIs & Services -> Credentials.
# Recommended: Restrict key to YouTube Data API v3 only (and server IP if static).
# Strictly server-side — NEVER prefix with VITE_ or expose to browser/Android APK code.
# Endpoints: GET /api/youtube/search, GET /api/youtube/video/:videoId, GET /api/youtube/playlist/:playlistId
# When omitted, JARVIS automatically falls back to clickable YouTube search links.
YOUTUBE_API_KEY=your_youtube_api_key

# Express server port (default 3001 for dev proxy, 3000 for preview, 8080 for Cloud Run)
PORT=3001

# Allowed CORS origin(s) for browser frontend (comma-separated or * for development)
CORS_ORIGIN=*

# Optional Bearer access token to lock down /api/* routes (leave empty for open access)
APP_ACCESS_TOKEN=

# Optional frontend override if hosting frontend and backend on separate domains
# Leave blank when serving both via Express or Vercel (same-origin /api)
VITE_API_BASE_URL=
