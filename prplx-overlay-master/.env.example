# Optional Direct AI Provider Configuration (Perplexity Overlay v1.1.0)
# Copy this file to .env and configure whichever provider(s) you prefer.
# All providers can also be configured at runtime inside the overlay Settings panel.

# 1. Google Gemini API (Direct AI default when set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. Local Ollama (100% private / offline, supports vision models like llava or llama3.2-vision)
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# 3. OpenAI-Compatible API (OpenAI, Groq, OpenRouter, LM Studio, Together, etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
