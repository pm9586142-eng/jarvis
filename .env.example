# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Gemini model name used for Android direct API calls (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional Express backend base URL (e.g. https://your-jarvis-server.run.app).
# When set (not "UNSET"), Android streams via /api/chat/stream so API keys stay off the APK.
# Keep "UNSET" to call free providers directly using keys from AI Studio Secrets.
BACKEND_URL=UNSET

# Optional bearer token matching APP_ACCESS_TOKEN on the Express server.
APP_ACCESS_TOKEN=UNSET

# Optional Groq Free API key for automatic zero-cost failover if Gemini hits HTTP 429.
# Only curated free open-weight models are permitted.
GROQ_API_KEY=MY_GROQ_API_KEY

# Optional OpenRouter Free API key for automatic zero-cost failover (strictly :free models
# verified live at $0 prompt & $0 completion pricing before every call).
OPENROUTER_API_KEY=MY_OPENROUTER_API_KEY

